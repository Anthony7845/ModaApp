<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Su pedido ha sido registrado con éxito. Puede enviar el comprobante por WhatsApp:"
        android:textColor="@color/dark_black"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEnviarCliente"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="8dp"
        android:text="Enviar a mi WhatsApp"
        android:textColor="@color/white"
        app:backgroundTint="#25D366"
        app:cornerRadius="25dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEnviarTienda"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="8dp"
        android:text="Avisar a la tienda"
        android:textColor="@color/white"
        app:backgroundTint="#25D366"
        app:cornerRadius="25dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAceptarFinal"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Aceptar / Volver al Catálogo"
        android:textColor="@color/pink_primary"
        app:cornerRadius="25dp"
        app:strokeColor="@color/pink_primary" />

</LinearLayout>